{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/projects-session-check.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/projects-session-check.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__(sap|abap)_[a-z0-9_]+_dev__.*",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/pre-cud-guard.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/workspace-write-guard.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
