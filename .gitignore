# Per-project documents: ignore all content (FS inputs, TS, scratchpads — customer
# data stays local), EXCEPT each project's project.md metadata so other machines
# cloning the repo get the project list + TR/package/system context.
# Note: "projects/" (dir-ignore) would make the re-includes impossible — git never
# descends into an ignored directory, hence the ** + !dir/ + !file pattern trio.
projects/**
!projects/*/
!projects/*/project.md

# Ignore scratchpad/temporary files
scratch/

.venv_markitdown/

# Claude Code local-only settings (personal overrides, not shared with the team)
.claude/settings.local.json

# Python bytecode cache
__pycache__/
*.pyc
