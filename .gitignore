# Per-project documents live in a separate git repo; `projects` here is a
# per-device link to it (Windows junction / macOS-Linux symlink). No trailing
# slash: a symlink is not a directory to git, so "/projects/" would miss it.
/projects

# Ignore scratchpad/temporary files
scratch/

.venv_markitdown/

# Claude Code local-only settings (personal overrides, not shared with the team)
.claude/settings.local.json

# .claude/ lock sentinel (rule §14) — per-device, created/deleted by the user only
.claude/.unlock

# Project-scoped MCP config: machine-specific binary paths + secrets — private per machine
.mcp.json
.env
.env.local

# Python bytecode cache
__pycache__/
*.pyc
